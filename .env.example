# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing here is hardcoded in source.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# --- Infrastructure (matches docker-compose.yml) ----------------------------
DATABASE_URL=postgresql://ejs:ejs@localhost:5432/email_scheduler
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# --- Sessions ---------------------------------------------------------------
# Any long random string. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Google OAuth -----------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Application type: Web application
# Authorized redirect URI must equal GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Slack OAuth ------------------------------------------------------------
# api.slack.com/apps -> Create App -> OAuth & Permissions
#   Scope: incoming-webhook
#   Redirect URL must equal SLACK_REDIRECT_URI below.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# --- Worker: concurrency ----------------------------------------------------
# How many email jobs a single worker process handles in parallel.
WORKER_CONCURRENCY=5

# --- Worker: minimum delay between sends ------------------------------------
# Minimum gap between two sends from the SAME sender, in ms.
# Enforced by an atomic Redis slot reservation, so it holds across
# concurrent jobs and across multiple worker instances.
DELAY_BETWEEN_EMAILS_MS=2000

# --- Rate limiting: two independent tiers -----------------------------------
# Tier 1 (hard): provider-throttling ceiling per sender. A campaign can never
# exceed this. Breaching it is what triggers the Slack notification.
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Optional global ceiling across ALL senders. 0 disables it.
MAX_EMAILS_PER_HOUR_GLOBAL=0

# Tier 2 (soft) is per-campaign and set by the user in the Compose form.
# This is the fallback when the form leaves it blank.
DEFAULT_CAMPAIGN_HOURLY_LIMIT=100

# When a job is pushed into the next hour window, jobs are re-spread by
# sequenceIndex * ORDER_STEP_MS to approximately preserve campaign order.
ORDER_STEP_MS=250

# --- SMTP senders (Ethereal) ------------------------------------------------
# Leave SMTP_SENDERS empty and the app auto-provisions this many Ethereal
# test accounts on first boot, caching them in .ethereal-accounts.json
# (gitignored) so restarts reuse the same inboxes.
SENDER_COUNT=3

# To use your own SMTP accounts instead, set a JSON array (overrides SENDER_COUNT):
# SMTP_SENDERS=[{"name":"Sales","fromEmail":"a@x.com","smtpHost":"smtp.ethereal.email","smtpPort":587,"smtpUser":"...","smtpPass":"..."}]
SMTP_SENDERS=

# --- BullMQ dashboard (/admin/queues) ---------------------------------------
BULL_BOARD_USER=admin
BULL_BOARD_PASS=admin

# --- Frontend (apps/frontend/.env) ------------------------------------------
# VITE_API_URL=http://localhost:4000
